# Gnani voice APIs. Keep the real value in .env.local; never commit it.
GNANI_API_KEY=

# Twilio Trial: calls are restricted to this verified demo operator number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_DEMO_RECIPIENT=
# Temporary HTTPS address from `ngrok http 3000`, without a trailing slash.
PUBLIC_BASE_URL=

# Delhivery Maps Bearer JWT. Omit this to use deterministic demo location data.
DELHIVERY_MAPS_TOKEN=
